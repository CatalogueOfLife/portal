---
import Content from '@layouts/Content.astro';
import Homonyms from '@components/Homonyms.astro';
import { metadata } from '@data/releaseMetadata';
import { baseKey, extendedKey } from '@data/versions';

// Static page: the report loads client-side from ChecklistBank's duplicates API
// and switches to the Base release itself on ?v=br (see Homonyms.astro).
const fm = {
  title: 'Homonyms',
  tagline: 'Identical names used for more than one taxon',
  section_id: 'data',
  toc: false,
  imageUrl: '/images/species/Octopus_vulgaris.jpg',
  imageCaption:
    '_Octopus vulgaris_ Cuvier, 1797 - [Photo CC By Ben Jobson](https://www.inaturalist.org/observations/191862203)',
};

const sources = Object.fromEntries(metadata.sources.map((s) => [String(s.key), s.alias ?? s.title ?? `#${s.key}`]));
---

<Content frontmatter={fm}>
  <Homonyms
    api={metadata.api}
    extendedKey={extendedKey}
    baseKey={baseKey}
    extendedAlias={metadata.current.alias ?? ''}
    baseAlias={metadata.base?.current.alias ?? ''}
    auth={import.meta.env.PUBLIC_COL_AUTH || ''}
    sources={sources}
  />
</Content>
